# An example only. Load this environment explicitly; Django does not auto-read it.
DJANGO_SETTINGS_MODULE=tom_snclock.production_settings
TOM_SECRET_KEY=
TOM_ALLOWED_HOSTS=tom.snclock.com
TOM_DATABASE_PATH=/srv/snclock-tom/shared/db.sqlite3
TOM_STATIC_ROOT=/srv/snclock-tom/shared/static
SNCLOCK_FRONTEND_DIST=/srv/snclock-tom/current/frontend/dist
# A trusted local report file; assets/ must sit beside it. Leave empty until supplied.
TELESCOPE_SNAPSHOT_PATH=
TELESCOPE_SNAPSHOT_SYNTHETIC=0
# Native transport secrets only; enable profiles explicitly in private local_settings.py.
# See docs/TELESCOPE_OPERATIONS.md. Empty values never authorize a request.
SNCLOCK_LCO_TOKEN=
SNCLOCK_LCO_ARCHIVE_TOKEN=
SNCLOCK_LT_USERNAME=
SNCLOCK_LT_PASSWORD=
SNCLOCK_TRT_TOKEN=
